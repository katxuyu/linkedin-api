FROM python:3.11.13-slim

# Set working directory
WORKDIR /app

# Production environment settings
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV PYTHONPATH=/app
ENV FLASK_APP=app.py
ENV FLASK_ENV=production
ENV PLAYWRIGHT_HEADLESS=1

# Install system dependencies required for Playwright/Chromium
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libpq-dev \
    curl \
    # Chromium/Playwright dependencies
    libglib2.0-0 \
    libnss3 \
    libfontconfig1 \
    libx11-6 \
    libxcomposite1 \
    libxcursor1 \
    libxdamage1 \
    libxext6 \
    libxfixes3 \
    libxi6 \
    libxrandr2 \
    libxss1 \
    libxtst6 \
    libatk1.0-0 \
    libatk-bridge2.0-0 \
    libcups2 \
    libdbus-1-3 \
    libdrm2 \
    libexpat1 \
    libgbm1 \
    libgdk-pixbuf-xlib-2.0-0 \
    libpango-1.0-0 \
    libasound2 \
    libatspi2.0-0 \
    libxshmfence1 \
    fonts-unifont \
    libxkbcommon0 \
    libcairo2 \
    # Clean up
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

# Copy requirements and install Python dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Install Playwright system dependencies as root
RUN playwright install-deps chromium

# Create non-root user for security
RUN useradd --create-home --shell /bin/bash appuser \
    && chown -R appuser:appuser /app

# Copy application code
COPY . .

# Remove unnecessary files for production
RUN rm -rf __pycache__ .pytest_cache .git tests/ *.md

# Ensure appuser owns everything
RUN chown -R appuser:appuser /app

# Switch to appuser
USER appuser

# Install Playwright browser (downloads to /home/appuser/.cache/ms-playwright/)
RUN playwright install chromium

# Expose port
EXPOSE 5001

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:5001/health || exit 1

# Run the application with Gunicorn
# Use sync workers (default) - gevent conflicts with Playwright's synchronous API.
# We must also force a single thread because the LinkedIn browser session lives in-process
# and Playwright's sync API cannot hop across threads. Horizontal scaling should happen
# via multiple containers instead of multi-threading in one worker.
# Increased timeout to 300s for long-running operations (captcha solving, profile fetching).
CMD ["gunicorn", "app:app", "--workers", "1", "--threads", "1", "--bind", "0.0.0.0:5001", "--log-level", "info", "--access-logfile", "-", "--timeout", "300"]

