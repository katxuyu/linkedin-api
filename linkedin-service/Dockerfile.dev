FROM python:3.11.13-slim

# Set working directory
WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

# Install system dependencies
RUN apt-get update && apt-get install -y \
    build-essential \
    libpq-dev \
    curl \
    libglib2.0-0 \
    libnss3 \
    libfontconfig1 \
    libx11-6 \
    libxcomposite1 \
    libxcursor1 \
    libxdamage1 \
    libxext6 \
    libxfixes3 \
    libxi6 \
    libxrandr2 \
    libxss1 \
    libxtst6 \
    libatk1.0-0 \
    libatk-bridge2.0-0 \
    libcups2 \
    libdbus-1-3 \
    libdrm2 \
    libexpat1 \
    libgbm1 \
    libgdk-pixbuf-xlib-2.0-0 \
    libpango-1.0-0 \
    libasound2 \
    libatspi2.0-0 \
    libxshmfence1 \
    fonts-unifont \
    libxkbcommon0 \
    libcairo2 # Needed when running playwright in dev (UI mode) \ 
    && rm -rf /var/lib/apt/lists/*

# RUN apt-get update && apt-get install -y \
#     wget \
#     gnupg \
#     && rm -rf /var/lib/apt/lists/*

# # Install Playwright dependencies
# RUN pip install playwright==1.40.0
# RUN playwright install chromium
# RUN playwright install-deps chromium

# Copy requirements and install Python dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
# Install Playwright browser engine
RUN playwright install chromium

# Copy application code
COPY . .

# Set environment variables
# ENV PYTHONPATH=/app:/home/ubuntu/Documents/linkedin-api
ENV PYTHONPATH=/app
ENV FLASK_APP=app.py
ENV FLASK_ENV=production
ENV PLAYWRIGHT_HEADLESS=1

# Expose port
EXPOSE 5001

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:5001/health || exit 1

# Run the application
# CMD ["python", "app.py"]
# Use sync workers (default) - gevent conflicts with Playwright's synchronous API.
# Force single-threaded workers for the same reason noted in Dockerfile.prod: the active
# Playwright browser instance lives inside the process and cannot be switched between threads.
# Scale by running multiple containers instead of multiple threads.
CMD ["gunicorn", "app:app", "--workers", "1", "--threads", "1", "--bind", "0.0.0.0:5001", "--log-level", "info", "--access-logfile", "-", "--timeout", "300"]
